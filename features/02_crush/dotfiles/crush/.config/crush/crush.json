          "can_reason": true,
          "context_window": 159456,
          "cost_per_1m_in": 0.14,
          "cost_per_1m_out": 0.9,
          "supports_attachments": true
        },
        {
          "name": "Qwen 3.6 35B (coding)",
          "id": "qwen36-coding",
