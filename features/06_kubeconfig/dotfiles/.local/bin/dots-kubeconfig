#!/usr/bin/env bash
# Refresh the kubeconfigs committed in hnatekmarorg/devops-cluster.
#
#   dots-kubeconfig            # dev and prod
#   dots-kubeconfig dev
#
# Each kubeconfig carries no credential: endpoint, public CA, and a kubelogin
# exec block. The CA changes when a cluster is rebuilt, so this is a command to
# re-run rather than a one-time install step. Contexts are named dev-k8s and
# prod-k8s so they cannot collide with a user's own dev/prod contexts.
set -euo pipefail

REPO="${DEVOPS_CLUSTER_REPO:-hnatekmarorg/devops-cluster}"
REF="${DEVOPS_CLUSTER_REF:-main}"
RAW_BASE="https://raw.githubusercontent.com/${REPO}/${REF}/terraform/clusters"
DEST="${DEVOPS_KUBECONFIG_DIR:-$HOME/.kube/devops-cluster}"
TARGET="${DEVOPS_KUBECONFIG_TARGET:-$HOME/.kube/config}"

err() { printf 'dots-kubeconfig: %s\n' "$*" >&2; }
die() {
  err "$@"
  exit 1
}

command -v kubectl >/dev/null 2>&1 || die "kubectl is required (run bootstrap.sh first)"
command -v curl >/dev/null 2>&1 || die "curl is required"

context_for() { printf '%s-k8s' "$1"; }

refresh() {
  local cluster="$1" ctx="$2" work src merged work_target
  work="$(mktemp -d)"
  src="$work/kubeconfig.yaml"

  curl -fsSL --retry 3 --retry-delay 2 "$RAW_BASE/$cluster/kubeconfig.yaml" -o "$src" ||
    {
      rm -rf "$work"
      die "cannot download the $cluster kubeconfig from $REPO@$REF"
    }

  # Same invariant as devops-cluster/scripts/kubeconfig.sh: a credential in a
  # file this command copies around must stop the run, not get installed.
  if grep -qE 'client-certificate-data|client-key-data|^ *token:|password:' "$src"; then
    rm -rf "$work"
    die "refusing the $cluster kubeconfig: it contains credential material"
  fi

  local old_ctx old_cluster server
  old_ctx="$(kubectl --kubeconfig "$src" config current-context)"
  old_cluster="$(kubectl --kubeconfig "$src" config view --raw -o jsonpath='{.contexts[0].context.cluster}')"
  server="$(kubectl --kubeconfig "$src" config view --raw \
    -o jsonpath="{.clusters[?(@.name==\"$old_cluster\")].cluster.server}")"
  kubectl --kubeconfig "$src" config view --raw \
    -o jsonpath="{.clusters[?(@.name==\"$old_cluster\")].cluster.certificate-authority-data}" |
    base64 -d >"$work/ca.crt"
  if [ ! -s "$work/ca.crt" ]; then
    rm -rf "$work"
    die "the $cluster kubeconfig has no cluster CA"
  fi

  kubectl --kubeconfig "$src" config rename-context "$old_ctx" "$ctx" >/dev/null
  kubectl --kubeconfig "$src" config set-cluster "$ctx" \
    --server="$server" --certificate-authority="$work/ca.crt" --embed-certs=true >/dev/null
  kubectl --kubeconfig "$src" config set-context "$ctx" --cluster="$ctx" >/dev/null
  if [ "$old_cluster" != "$ctx" ]; then
    kubectl --kubeconfig "$src" config delete-cluster "$old_cluster" >/dev/null
  fi

  mkdir -p "$DEST"
  install -m 0600 "$src" "$DEST/$cluster.yaml"

  # Work on a copy: the target is replaced only after the merge is verified.
  mkdir -p "$(dirname "$TARGET")"
  work_target="$work/target.yaml"
  if [ -s "$TARGET" ]; then
    cp -p "$TARGET" "$work_target"
    # `view --flatten` keeps the first definition of a name, so a stale entry
    # in the target would win over the refreshed one. Drop ours first.
    if kubectl --kubeconfig "$work_target" config get-contexts -o name 2>/dev/null | grep -qx "$ctx"; then
      kubectl --kubeconfig "$work_target" config delete-context "$ctx" >/dev/null
    fi
    if kubectl --kubeconfig "$work_target" config get-clusters 2>/dev/null | grep -qx "$ctx"; then
      kubectl --kubeconfig "$work_target" config delete-cluster "$ctx" >/dev/null
    fi
  else
    printf 'apiVersion: v1\nkind: Config\nclusters: []\ncontexts: []\nusers: []\n' >"$work_target"
  fi

  merged="$work/merged.yaml"
  KUBECONFIG="$work_target:$DEST/$cluster.yaml" kubectl config view --flatten --raw >"$merged"
  if ! kubectl --kubeconfig "$merged" config get-contexts -o name | grep -qx "$ctx"; then
    rm -rf "$work"
    die "merge did not produce context $ctx"
  fi

  if [ -f "$TARGET" ]; then
    cp -p "$TARGET" "$TARGET.dots-kubeconfig.bak"
  fi
  install -m 0600 "$merged" "$TARGET"
  rm -rf "$work"
  printf 'dots-kubeconfig: %s -> context %s (%s)\n' "$cluster" "$ctx" "$server"
}

main() {
  local want=()
  case "${1:-all}" in
  all) want=(dev prod) ;;
  dev | prod) want=("$1") ;;
  -h | --help)
    printf 'usage: dots-kubeconfig [dev|prod|all]\n'
    exit 0
    ;;
  *) die "unknown cluster '$1' (use dev, prod, or all)" ;;
  esac

  command -v kubelogin >/dev/null 2>&1 ||
    err "kubelogin is not on PATH; the contexts will not authenticate until it is"

  local c
  for c in "${want[@]}"; do
    refresh "$c" "$(context_for "$c")"
  done
  printf 'dots-kubeconfig: merged into %s\n' "$TARGET"
}

main "$@"
