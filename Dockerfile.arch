FROM archlinux:latest

# Refresh keyring first to avoid signature errors on a fresh image.
RUN pacman -Sy --noconfirm archlinux-keyring \
        && pacman -S --noconfirm --needed \
        git \
        curl \
        tar \
        findutils \
        python \
        gcc \
        make \
        stow \
        && rm -rf /var/cache/pacman/pkg/*

# Copy repo into the image
COPY . /dots

WORKDIR /dots

# Arch has no default /root/.bash_profile/.profile, but clear if present
RUN rm -f /root/.bash_profile /root/.profile

# Ensure Go and go-installed binaries are in PATH for feature installers
ENV PATH=/usr/local/go/bin:/usr/local/bin:/root/go/bin:/root/.cargo/bin:$PATH

# Run the full bootstrap at build time — CI gate.
RUN bash bootstrap.sh

CMD ["bash"]
