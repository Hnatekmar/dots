#!/usr/bin/env python3
"""
vlook — Ask Qwen3.6-VL to inspect an image.

Usage:
  vlook <image_path_or_url> ["question"]
  vlook ocr <image_path_or_url>
  vlook scan <image_path_or_url>

Routes to Qwen3.6-35B-A3B on .189:8030 (always hot, multimodal).
Output is plain text — the model's description/transcription.
Thinking is disabled for fast, direct output.

Designed to be called by coding agents (Crush, Hermes, etc.) that
can exec shell but can't natively process images.
"""

import base64
import json
import os
import sys
import urllib.request

VLLM_URL = os.environ.get("VLOOK_URL", "http://172.16.100.189:8030/v1/chat/completions")
MODEL = os.environ.get("VLOOK_MODEL", "cyankiwi/Qwen3.6-35B-A3B-AWQ-4bit")


def resolve_data_url(image: str) -> str:
    if image.startswith(("http://", "https://")):
        return image
    if not os.path.isfile(image):
        print(f"Error: file not found: {image}", file=sys.stderr)
        sys.exit(1)
    # Detect mime type
    import subprocess
    mime = subprocess.check_output(
        ["file", "--mime-type", "-b", image], text=True
    ).strip() or "image/png"
    with open(image, "rb") as f:
        b64 = base64.b64encode(f.read()).decode()
    return f"data:{mime};base64,{b64}"


def main() -> None:
    if len(sys.argv) < 2:
        print("Usage: vlook <image_path_or_url> [\"question\"]", file=sys.stderr)
        print("       vlook ocr <image_path_or_url>", file=sys.stderr)
        print("       vlook scan <image_path_or_url>", file=sys.stderr)
        sys.exit(1)

    # Subcommand dispatch
    if sys.argv[1] == "ocr" and len(sys.argv) >= 3:
        image = sys.argv[2]
        question = "Transcribe all visible text. Preserve layout, rows, columns, and labels when possible."
    elif sys.argv[1] == "scan" and len(sys.argv) >= 3:
        image = sys.argv[2]
        question = (
            "Perform a thorough visual scan of this image. Describe everything you see "
            "in detail: all text, UI elements, layout, colors, icons, data, and any "
            "notable features. Be exhaustive."
        )
    else:
        image = sys.argv[1]
        question = sys.argv[2] if len(sys.argv) >= 3 else "Describe this image in detail."

    data_url = resolve_data_url(image)

    payload = json.dumps(
        {
            "model": MODEL,
            "messages": [
                {
                    "role": "user",
                    "content": [
                        {"type": "text", "text": question},
                        {"type": "image_url", "image_url": {"url": data_url}},
                    ],
                }
            ],
            "max_tokens": 2048,
            "temperature": 0.3,
            "chat_template_kwargs": {"enable_thinking": False},
        }
    ).encode()

    req = urllib.request.Request(
        VLLM_URL, data=payload, headers={"Content-Type": "application/json"}
    )
    try:
        resp = urllib.request.urlopen(req, timeout=120)
        data = json.loads(resp.read())
        content = data["choices"][0]["message"]["content"]
        if content:
            print(content)
        else:
            # Fallback: if content is None, try reasoning
            reasoning = data["choices"][0]["message"].get("reasoning", "")
            if reasoning:
                print(reasoning, file=sys.stderr)
                print("Warning: model returned reasoning only (content was None)", file=sys.stderr)
                sys.exit(1)
            print("Error: model returned no content", file=sys.stderr)
            sys.exit(1)
    except Exception as e:
        print(f"Error: {e}", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
